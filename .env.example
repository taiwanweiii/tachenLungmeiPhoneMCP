# CurtainMCP 設定檔
# 請依照你的環境修改以下設定

# Ollama 服務設定
OLLAMA_BASE_URL=https://api.openai.com/v1
OLLAMA_MODEL=gpt-6-luna
OLLAMA_TIMEOUT_SECONDS=5
# LLM_PROVIDER: ollama | openai（OpenAI 相容，如 NVIDIA / LM Studio / vLLM）
LLM_PROVIDER=openai
# OpenAI 相容端點的 API Key（Ollama 可留空）
LLM_API_KEY=

# MCP Server 設定
MCP_BASE_URL=http://127.0.0.1:1987/mcp
MCP_TIMEOUT_SECONDS=5

# 語音設定
VOICE_ENABLED=true
VOICE_LANGUAGE=zh-TW
WAKE_WORD=你好助理

# STT 設定（選擇方案）
# STT_MODE: backend | google | disabled
STT_MODE=backend
STT_BACKEND_URL=http://192.168.1.100:5000/api/stt

# 畫面一打開預設登入的工號與密碼（要換帳號到設定頁重新登入；不想自動登入就刪掉這兩行）
DEFAULT_LOGIN_USER=
DEFAULT_LOGIN_PASSWORD=
